{
  "name": "anchor-sdk",
  "version": "0.1.0",
  "description": "On-device GNSS integrity monitoring SDK for Expo: raw C/N0 measurements, sensor fusion, six physics consistency checks, deterministic RAIM/FDE state machine, and on-device AI explanation.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "react-native",
    "expo",
    "gnss",
    "gps-integrity",
    "anti-spoofing",
    "anchor-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristopherJoshy/Anchor---Full-Build-.git",
    "directory": "packages/anchor-sdk"
  },
  "bugs": {
    "url": "https://github.com/ChristopherJoshy/Anchor---Full-Build-/issues"
  },
  "author": "ChristopherJoshy <ChristopherJoshy@users.noreply.github.com> (https://github.com/ChristopherJoshy)",
  "license": "MIT",
  "homepage": "https://github.com/ChristopherJoshy/Anchor---Full-Build-#readme",
  "dependencies": {
    "expo-location": "^57.0.14",
    "expo-sensors": "^57.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "json",
      "js"
    ]
  }
}
